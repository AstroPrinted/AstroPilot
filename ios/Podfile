platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_settings = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_settings)
    raise "#{generated_settings} must exist. Run flutter pub get before pod install."
  end

  File.foreach(generated_settings) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found. Run flutter pub get to regenerate Generated.xcconfig.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      if target.name == 'permission_handler_apple'
        # Request only Bluetooth and foreground location on iOS.
        definitions << 'PERMISSION_BLUETOOTH=1'
        definitions << 'PERMISSION_LOCATION=0'
        definitions << 'PERMISSION_LOCATION_WHENINUSE=1'
      end
      if target.name == 'geolocator_apple'
        definitions << 'BYPASS_PERMISSION_LOCATION_ALWAYS=1'
      end
    end
  end
end
